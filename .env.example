PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/tekverse

# JWT
JWT_SECRET=tu_jwt_secret_muy_seguro_cambiar_en_produccion_12345678
JWT_EXPIRE=30d

# URLs
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Cloudinary (Para subida de archivos/imágenes)
CLOUDINARY_NAME=tu_cloudinary_name
CLOUDINARY_KEY=tu_cloudinary_api_key
CLOUDINARY_SECRET=tu_cloudinary_api_secret

# Seguridad
CORS_ORIGIN=http://localhost:3000,https://tu-dominio.com
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Email (Opcional - para notificaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_contraseña_app
SMTP_FROM=noreply@tekverse.dev

# Stripe (Para pagos de tiers)
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxx

# AWS S3 (Alternativa a Cloudinary)
AWS_ACCESS_KEY_ID=tu_aws_key
AWS_SECRET_ACCESS_KEY=tu_aws_secret
AWS_S3_BUCKET=tu_bucket_name
AWS_REGION=us-east-1

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/tekverse.log

# Desarrollo
DEBUG=true
SEED_DB=false